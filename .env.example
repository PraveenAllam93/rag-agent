BIND_IP=

# Postgres database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO configuration
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Redis
REDIS_AUTH=

# ClickHouse (Langfuse trace store)
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Langfuse
# SALT and ENCRYPTION_KEY protect stored API keys/secrets — losing or
# rotating them makes existing encrypted data unreadable.
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Must equal the exact address your browser uses to reach langfuse-web —
# e.g. http://100.103.102.61:3010 on this host, NOT http://localhost:3010.
NEXTAUTH_URL=
# Same "must be browser-reachable" rule — e.g. http://100.103.102.61:9010.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=
